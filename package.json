{
  "name": "the-council",
  "version": "1.0.0",
  "description": "🧭 ROADMAP – “El Consejo” (Multi-Agente IA)\r 🎯 Caso de Uso Principal: Asistente de Desarrollo de Software\r 💡 El sistema está diseñado para codeo pero es extensible a cualquier dominio",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js",
    "start:mock": "node scripts/start-mock.js",
    "frontend:install": "npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "build": "npm run frontend:build",
    "docker:up": "docker compose up --build",
    "docker:up:full": "docker compose --profile full up --build",
    "test": "npm run test:all",
    "test:all": "node tests/test-council.js && node tests/test-etapa3-rondas.js && node tests/test-etapa4-sintesis.js && node tests/test-contexto-consejo.js && node tests/test-etapa5-identificacion.js && node tests/test-colaboracion-agentes.js && node tests/test-etapa6-config.js",
    "test:council": "node tests/test-council.js",
    "test:rondas": "node tests/test-etapa3-rondas.js",
    "test:sintesis": "node tests/test-etapa4-sintesis.js",
    "test:contexto": "node tests/test-contexto-consejo.js",
    "test:identificacion": "node tests/test-etapa5-identificacion.js",
    "test:colaboracion": "node tests/test-colaboracion-agentes.js",
    "test:config": "node tests/test-etapa6-config.js",
    "test:ci": "npm run test:all",
    "start:test": "PORT=3000 HOST=127.0.0.1 node src/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kevinmass/The-Council.git"
