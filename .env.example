# Server Configuration
PORT=3000
HOST=0.0.0.0

# Ollama Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# LLM / modo offline
# MOCK_LLM=true            # fuerza respuestas simuladas: nunca se contacta a Ollama
# LLM_FALLBACK_MOCK=true   # (por defecto) si Ollama no responde o el modelo no
#                          # está instalado, responde simulado en vez de fallar.
#                          # Poné false para exigir Ollama real.

# Database Configuration
DB_PATH=./data/council.db
